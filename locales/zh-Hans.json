      "sourceSha256": "0ed77fd2619ba8ab3e1cce72c8e61d887d551ca1220164b88ab1aa66bba7177d"
    },
    "inner-thought.index.text.0004": {
      "value": "功能",
      "sourceSha256": "5697d03daef4de9cf8db7cb11755f71358a32b4acca94909a9d449f71040d2dd"
    },
    "inner-thought.index.text.0005": {
      "value": "无障碍",
      "sourceSha256": "d3368cbffe23c98da887d279a1b5c74b7618ba5c0488cbed30cf304f8f9398a1"
    },
    "inner-thought.index.text.0006": {
      "value": "隐私",
      "sourceSha256": "54a57c3147c49f33de5898b87084ad2b14c4ab308f762454bf92aca907478ad5"
    },
    "inner-thought.index.text.0007": {
      "value": "支持",
      "sourceSha256": "be91940b79f469101df9a50544b6873aa5509a12f1f93f1cb5e3be3990d344b3"
    },
    "inner-thought.index.text.0008": {
      "value": "推出信息",
      "sourceSha256": "12f67f8539c46701e62d1c50254cf025c22a992b06fea6d4c0e19705f21f4cac"
    },
    "inner-thought.index.text.0009": {
      "value": "所有应用",
      "sourceSha256": "01bed311e7d0c963a5f8afe3dd3c99c8140d887d92c602b94b9309fa51b32723"
    },
    "inner-thought.index.text.0010": {
      "value": "一个动作。说出内心。安全保存。",
      "sourceSha256": "41d1d45dce382ab16e909b47fe43c4430f56bd48dce3dfdf961e87444cadef53"
    },
    "inner-thought.index.text.0011": {
      "value": "在 App Store 获取 Inner Thought",
      "sourceSha256": "55384cf91c27972055904ad17f36e2bf2797f7aaacc12268fad3b0379f76ba7c"
    },
    "inner-thought.index.text.0012": {
      "value": "它为何存在",
      "sourceSha256": "77890c5d4168a3af5e9a2611921690bb9f2f6c2a02e7269ab9b268f2f1bbed00"
    },
    "inner-thought.index.text.0013": {
      "value": "滚动接住想法",
      "sourceSha256": "ef2e2dd538a01860c597ce63e3a8e6d1f6cdb5523005a9733f342694b5706145"
    },
    "inner-thought.index.text.0014": {
      "value": "一个留住本会消逝之物的地方。",
      "sourceSha256": "bfaaf37bac046c5c313694c43440bc55662ac8a07d15bd777b674c5587e87be9"
    },
    "inner-thought.index.text.0015": {
      "value": "Inner Thought 帮助人们在创意消失前将它留住，并以隐私、尊严与从容守护它。说出来、写下来、拍下来或录下来。以后再整理，也可以永远不整理。",
      "sourceSha256": "8acbd9a140589616006e2468c1039b6c98077eb35dd0bc40f4e52856f3569cba"
    },
    "inner-thought.index.text.0016": {
      "value": "想法来时随时就绪；没有想法时保持安静。",
      "sourceSha256": "7906c0841af84d1273e3967685e20d53531e0402a5198e7490d3baa7335a5090"
    },
    "inner-thought.index.text.0017": {
      "value": "口述",
      "sourceSha256": "b0a422a0de4af8203cfaa0ba6a5780c3e2d53d7df1f91b9022cd0cd7288ae0b1"
    },
    "inner-thought.index.text.0018": {
      "value": "书写",
      "sourceSha256": "4c6031d1d40cc16e9c579a3a56e8a51dfbbd439367e311d241b32afd845538d5"
    },
    "inner-thought.index.text.0019": {
      "value": "所见",
      "sourceSha256": "8894cf30aed05a787922b8da70ce6ec4e86879ac21f97fbf78a2da27bdae2b20"
    },
    "inner-thought.index.text.0020": {
      "value": "地点",
      "sourceSha256": "cfa70d64a48226d4b667f0a25442e3ab81b6195268ad85acec3f6e909669394f"
    },
    "inner-thought.index.text.0021": {
      "value": "私密保存",
      "sourceSha256": "187c44112cef269684fa358a68cefa913e3d18f55b0936b55f56dbbb2ec7d43d"
    },
    "inner-thought.index.text.0022": {
      "value": "先捕捉",
      "sourceSha256": "f16972c086c637774011108f9fe5433d983d07feb9ab6bd5f28f22bb590ed900"
    },
    "inner-thought.index.text.0023": {
      "value": "想法不必已经准备好。",
      "sourceSha256": "5933bf308d531fafaedd4fc58f77ede50cd6808d63223112d0cf9ff14c072114"
    },
    "inner-thought.index.text.0024": {
      "value": "标题可以等，分类可以等，想法不能。Inner Thought 缩短灵感抵达与它被安全保存之间的距离。",
      "sourceSha256": "c989b3bf634933cecb098efba74950e9ab79afe16a148f2f520aeac08ce6fbd2"
    },
    "inner-thought.index.text.0025": {
      "value": "语音",
      "sourceSha256": "87bf2bc08589f0bd4a078db145c34ad5e14b8fda53c3ae65b78601294913df95"
    },
    "inner-thought.index.text.0026": {
      "value": "保留原始录音，并在你选择时保留完整文字稿。",
      "sourceSha256": "556be93771b4491c87edf67be68c65d1cfb43a3b690856b41ea2b37cae4bd968"
    },
    "inner-thought.index.text.0027": {
      "value": "文字",
      "sourceSha256": "71988c4d8e0803ba4519f0b2864c1331c14a1890bf8694e251379177bfedb5c3"
    },
    "inner-thought.index.text.0028": {
      "value": "听写但不保留音频，或直接写下刚刚浮现的内容。",
      "sourceSha256": "f6eb4c685dfb281de73346b9f37de2b980f5a1deaf49b4be674279ea32277683"
    },
    "inner-thought.index.text.0029": {
      "value": "地点",
      "sourceSha256": "e9463dccf0541a9778589691543fd69249759d5de6a97cd57d6420c3e5d92baa"
    },
    "inner-thought.index.text.0030": {
      "value": "只有当地点确实属于这段想法时，才添加一次性位置。",
      "sourceSha256": "e24ad3c02ca97336c235261dffbf5461a75b3fcf5d96c6802fef156120b7dedb"
    },
    "inner-thought.index.text.0031": {
      "value": "媒体",
      "sourceSha256": "d357175cfe8978d39b0f86552dcd9404973493e2816101d9ff6c05ee248ef6bd"
    },
    "inner-thought.index.text.0032": {
      "value": "将照片和视频私密地保存在这段记忆里。",
      "sourceSha256": "058fdd98be1df198fa2683ca95126bab4df5fffcc0dac1730ec14f456bfe3e31"
    },
    "inner-thought.index.text.0033": {
      "value": "从第一天开始无障碍",
      "sourceSha256": "523236e02a3c796e9d1432cb6356540f02c00f3167026ffed00ad19306752450"
    },
    "inner-thought.index.text.0034": {
      "value": "同一个 Inner Thought，服务每个人。",
      "sourceSha256": "e30293184fd82ba5ce5679071bef41a886e47f675796f0713af59591704b0355"
    },
    "inner-thought.index.text.0035": {
      "value": "无障碍决定这项承诺是否真实；它不是单独版本，也不是最后的润色。每项常用任务都会针对不同的观看、聆听、移动、阅读与互动方式进行设计和测试。",
      "sourceSha256": "5d2d5cb0d4cd9fd66df8d5b3bb2d3b21de730f977762c82736556e19764cbace"
    },
    "inner-thought.index.text.0036": {
      "value": "VoiceOver、Voice Control、Switch Control、Larger Text、Reduce Motion、对比度、键盘操作和不依赖声音的清晰状态，都是发布要求。",
      "sourceSha256": "19f3e593ab5dbd81aac36991f9e7522d63ab8af8af51834c3d4013e04d957516"
    },
    "inner-thought.index.text.0037": {
      "value": "隐私源于设计",
      "sourceSha256": "485ca594ccc9003ba4908cc7f0024a92ce2a89f2e3e49fb4acbc61770eff6580"
    },
    "inner-thought.index.text.0038": {
      "value": "你的想法不是商品。",
      "sourceSha256": "fb52f79a1c0928f1448819f734433dc29a0dbbd5cfe5cc801b7be45c9afb0d18"
    },
    "inner-thought.index.text.0039": {
      "value": "Inner Thought 无需账户，也没有应用内广告或第三方分析。保存的标题、文字、位置、自定义标签、录音、照片与视频都会在设备上加密，密钥保存在 iOS Keychain。",
      "sourceSha256": "634169d1efd8fdbab9d5b610c6e5d6607047db018f62eeca7eaa92ecdd253dc5"
    },
    "inner-thought.index.text.0040": {
      "value": "不在后台追踪位置。",
      "sourceSha256": "7fd95729ad05600e66ac921277613ac2223d21daa64d8decbb8fe4fb87a4b87d"
    },
    "inner-thought.index.text.0041": {
      "value": "不广泛扫描照片图库。",
      "sourceSha256": "0e165b2540bfc5ab53b700dff47d990e9e57ffc805477cfa29ce3a5274b65d56"
    },
    "inner-thought.index.text.0042": {
      "value": "在设备上转录；默认不在小组件或日志中显示文字稿内容。",
      "sourceSha256": "54b39488b88b221016fb48ff9c5c1842fdb65b90b43c9d9bb4f281a0d4c9bb42"
    },
    "inner-thought.index.text.0043": {
      "value": "你的私密想法旁边不会放着订阅。",
      "sourceSha256": "6b323a77bc4a88d70cb184dc74b19da36be509b1b2c135b6e07bf7c212880de6"
    },
    "inner-thought.index.text.0044": {
      "value": "阅读完整隐私政策",
      "sourceSha256": "58db9d103eec30212473637b05e70be90814d2cdc04e34fe2199eaab708cf619"
    },
    "inner-thought.index.text.0045": {
      "value": "给这项工作的祝福",
      "sourceSha256": "dbd179de3df4dd7951205dda69e22dd6ac2e447dfbf8df318ef08d46926f4b78"
    },
    "inner-thought.index.text.0046": {
      "value": "愿这个应用帮助人们留住自己的创造力。",
      "sourceSha256": "d358f76aab28b9f1cbe6db954bb8eca12f911f882ed96b53fad6aafd435db23a"
    },
    "inner-thought.index.text.0047": {
      "value": "愿它美好、有帮助、有成果且真正实用。",
      "sourceSha256": "1467b24d2ac915df42a189eb0228d706873cae17975af213c4c6ae1a600e42a7"
    },
    "inner-thought.index.text.0048": {
      "value": "愿它抵达那些需要一个地方安放想法的人。",
      "sourceSha256": "f1b28d494f8ebbdbbdceae6e87bf694e8a5eff4af92a2b82d4a01be147419adc"
    },
    "inner-thought.index.text.0049": {
      "value": "小心保管",
      "sourceSha256": "93bf5cb9ace257f1586c526a925ad13ca1135511cfc6ffb96cd4245f396fd870"
    },
    "inner-thought.index.text.0050": {
      "value": "你的内心世界值得美丽和清晰。阅读完整的隐私承诺，寻求帮助，或者在您需要我们时联系真人。",
      "sourceSha256": "f0dfb02b9e5215f69c3eff154df9d41ac8a1541ddd9f0087ed5181eaf0cd4890"
    },
    "inner-thought.index.text.0051": {
      "value": "技术工艺",
      "sourceSha256": "ed7b84a2eb484c5b73f39e114cd551a47e8e1b764b945ccfaa1c98280fc3439b"
    },
    "inner-thought.index.text.0052": {
