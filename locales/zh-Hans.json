    "inner-thought.support.text.0017": {
      "value": "可选位置、相机、Photos 选择器与导出。",
      "sourceSha256": "4c5bdda2a86327375f1e5aeb5abf46772494f7890c99c84377d3aa8ace17bbca"
    },
    "inner-thought.support.text.0018": {
      "value": "隐私与删除",
      "sourceSha256": "15576efa7d0c8874df23d30eb226581a1769e56d2a7831dde382aa5261a6bf7d"
    },
    "inner-thought.support.text.0019": {
      "value": "加密、Recently Deleted 与永久移除。",
      "sourceSha256": "9176f0088e7ccbf3f6ba11f9addf21549ae6edb76e189182b4df3c576e9d1d90"
    },
    "inner-thought.support.text.0020": {
      "value": "录音与播放",
      "sourceSha256": "66b933593a7a9bf778cc4c0449d8d220af32b6cb032cacf2be54cc7f87dce7a6"
    },
    "inner-thought.support.text.0021": {
      "value": "在 iPhone Settings > Privacy & Security > Microphone 中允许麦克风访问。只有在 Inner Thought Settings 启用相应选项时，新的语音想法才会自动开始。",
      "sourceSha256": "c3a5fc315167be524901cf26e16da7e8f74c5085f9da1c45de15a5569a8d4288"
    },
    "inner-thought.support.text.0022": {
      "value": "如果播放无声，请检查 iPhone 音量、Control Center 中的音频目的地和已连接的 Bluetooth 设备。未选择其他目的地时，Inner Thought 会请求 iOS 通过扬声器播放。",
      "sourceSha256": "bc74b6543e50baa7fac9a1e4593ea1afa30bcdb8dbb2966201ef721e675d2c6b"
    },
    "inner-thought.support.text.0023": {
      "value": "转录",
      "sourceSha256": "30bf7b9b9540d4e11819ffbadf3ae6fe4c7ca94c8b433391e50e47e14a9d6cbf"
    },
    "inner-thought.support.text.0024": {
      "value": "转录可选，使用 Apple 的设备端识别。可用性取决于所选语言及其设备端语音模型是否安装。所有识别段落都会累积保存在想法中；自然停顿不会抹去先前文字。",
      "sourceSha256": "710df7da2d741b0ca1732ce809e1c21cf847422940044984fd893f14ab0d9495"
    },
    "inner-thought.support.text.0025": {
      "value": "你可以保留语音而不生成文字稿，听写文字而不保存音频，或直接输入。全局偏好位于 Settings；每次捕捉也可单独更改语音转录。",
      "sourceSha256": "dd83c23e7f9fa54df0cb88721c4f58ed4fb932f2fc0025d582ba8fd820c9193f"
    },
    "inner-thought.support.text.0026": {
      "value": "位置、照片与视频",
      "sourceSha256": "872971b981f9b2726026a2df69b51ec14f800216ecd91229008684dd7426e630"
    },
    "inner-thought.support.text.0027": {
      "value": "位置只是一个可选点，绝不是轨迹。若捕捉时未添加，可稍后从已保存想法中添加或更新。可在 Settings 关闭默认值，也可用捕捉屏幕控件只更改一条想法。",
      "sourceSha256": "c5d5d44a76ffac66a11efbd1c80a7a62b78eacf37a057f188f783106d0bf0293"
    },
    "inner-thought.support.text.0028": {
      "value": "照片和视频默认私密保存在 Inner Thought 中。只有想在 Apple Photos 中增加副本时才使用 Save to Photos。",
      "sourceSha256": "22bcd1a59fcf3e2204a6a2ad6405c7e62f48aa535a9d50d07cf768110c8dafe4"
    },
    "inner-thought.support.text.0029": {
      "value": "隐私、存储与删除",
      "sourceSha256": "d494f0570107f582b67ba50fb22bc359f4c88e0d71f2fcaa5045e471cbe223c6"
    },
    "inner-thought.support.text.0030": {
      "value": "保存的想法内容和媒体都在设备上加密，密钥由 iOS Keychain 保存。请阅读",
      "sourceSha256": "6488f1a3749dba4c705123c25e7b175df0fa34a59c864ba4f81716596e3a769b"
    },
    "inner-thought.support.text.0031": {
      "value": "完整隐私政策",
      "sourceSha256": "93e08bc863f1ef264a3940738b7b65dd84073a2d4c0e448045ac5b42ea49fd32"
    },
    "inner-thought.support.text.0032": {
      "value": "了解准确边界。",
      "sourceSha256": "a8e45fe5ae377eed4a2dba1eec4a4d0c20dbde12270dd9a4f49b5ae099f7b27e"
    },
    "inner-thought.support.text.0033": {
      "value": "删除的想法可在 Settings > Recently Deleted 中恢复 30 天。Delete Forever 会立即移除；30 天后应用会自动移除。",
      "sourceSha256": "92992a360ee7c74cbbe035f7da26fb2823917b08947d348d784087ab235a9568"
    },
    "inner-thought.support.text.0034": {
      "value": "无障碍支持",
      "sourceSha256": "429f5d39ccc2f70ddc86028c1b7db989938503ce0e3b61415fbd86bdef7b11b2"
    },
    "inner-thought.support.text.0035": {
