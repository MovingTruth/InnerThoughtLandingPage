    },
    "inner-thought.support.text.0015": {
      "value": "设备端可用性、完整文字与逐条想法控制。",
      "sourceSha256": "2c29b6bb95e3a89d8da221ec33ec9646c95329324bc39e9fbc2a561753c74c2a"
